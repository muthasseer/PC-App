{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cloud": {
    "DataDirectory": "data",
    "DatabaseProvider": "Sqlite",
    "ConnectionString": "",
    "JwtIssuer": "awms-cloud",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "SiteOfflineAfterMinutes": 5,
    "LiveDataStaleSeconds": 90,
    "TimeZone": "UTC",
    "TrustForwardedHeaders": false,
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15,
    "LoginRateLimitPerMinute": 20,
    "RequireMfaForAdministrators": false
  }
}
