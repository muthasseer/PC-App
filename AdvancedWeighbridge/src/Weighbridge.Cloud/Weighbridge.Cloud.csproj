  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Weighbridge.Core\Weighbridge.Core.csproj" />
    <ProjectReference Include="..\Weighbridge.Data\Weighbridge.Data.csproj" />
    <ProjectReference Include="..\Weighbridge.Contracts\Weighbridge.Contracts.csproj" />
    <ProjectReference Include="..\Weighbridge.Reporting\Weighbridge.Reporting.csproj" />
  </ItemGroup>
  <ItemGroup>
