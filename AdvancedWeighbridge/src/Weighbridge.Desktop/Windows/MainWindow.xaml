<Window x:Class="Weighbridge.Desktop.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource s.app.title}" Width="1440" Height="900" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" Style="{StaticResource Window.Base}"
        Icon="/AdvancedWeighbridge;component/Resources/app.ico">
    <DockPanel>
        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="12,5">
            <DockPanel>
                <TextBlock x:Name="ClockText" DockPanel.Dock="Right" FontFamily="{StaticResource Font.Mono}" Margin="12,0,0,0" />
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="IndicatorPill" Style="{StaticResource Pill}"><TextBlock x:Name="IndicatorText" Foreground="White" FontSize="12" FontWeight="SemiBold" /></Border>
                    <Border x:Name="CloudPill" Style="{StaticResource Pill}"><TextBlock x:Name="CloudText" Foreground="White" FontSize="12" FontWeight="SemiBold" /></Border>
                    <TextBlock x:Name="ModeText" VerticalAlignment="Center" Margin="6,0,12,0" />
                    <TextBlock x:Name="UserText" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" />
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- Navigation -->
        <Border DockPanel.Dock="Left" Width="232" Background="{DynamicResource Brush.Nav}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,16,8,16">
                    <Image Source="/AdvancedWeighbridge;component/Resources/app-256.png" Width="32" Height="32" Margin="0,0,10,0" />
                    <TextBlock Text="{DynamicResource s.app.title}" Foreground="{DynamicResource Brush.NavText}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" Width="160" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,12">
                    <Button x:Name="SignOutButton" Content="{DynamicResource s.nav.signout}" Margin="12,0" Click="OnSignOut" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="NavPanel" />
                </ScrollViewer>
            </DockPanel>
        </Border>
        <!-- Page -->
        <ContentControl x:Name="PageHost" Focusable="False" />
    </DockPanel>
</Window>
