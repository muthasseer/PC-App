<Application x:Class="Weighbridge.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Order matters: [0] theme colours, [1] control styles, [2] strings. Loc and ThemeManager replace [0] and [2]. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Themes/Light.xaml" />
                <ResourceDictionary Source="Resources/Themes/Controls.xaml" />
                <ResourceDictionary Source="Resources/Strings/en.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
