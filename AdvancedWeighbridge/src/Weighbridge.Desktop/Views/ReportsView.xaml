<UserControl x:Class="Weighbridge.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Weighbridge.Desktop.Views">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource s.nav.reports}" Style="{StaticResource Text.H1}" />
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="{DynamicResource s.rep.kind}" Style="{StaticResource Text.Label}" />
                <ComboBox x:Name="KindBox" Width="260" />
            </StackPanel>
        </StackPanel>
        <local:TransactionFilterBar x:Name="Filter" DockPanel.Dock="Top" />
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="{DynamicResource s.rep.preview}" Style="{StaticResource Button.Primary}" Click="OnPreview" IsDefault="True" />
            <Button x:Name="XlsxButton" Content="Export Excel" Click="OnXlsx" />
            <Button x:Name="CsvButton" Content="Export CSV" Click="OnCsv" />
            <Button x:Name="PdfButton" Content="Export PDF" Click="OnPdf" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" x:Name="TitleText" Style="{StaticResource Text.H2}" Margin="0,0,0,4" />
        <TextBlock DockPanel.Dock="Bottom" x:Name="TotalsText" FontWeight="SemiBold" Margin="0,6,0,0" />
        <DataGrid x:Name="Grid" AutoGenerateColumns="False" />
    </DockPanel>
</UserControl>
