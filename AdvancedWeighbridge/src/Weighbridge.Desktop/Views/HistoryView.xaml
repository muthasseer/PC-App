<UserControl x:Class="Weighbridge.Desktop.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Weighbridge.Desktop.Infrastructure"
             xmlns:local="clr-namespace:Weighbridge.Desktop.Views">
    <UserControl.Resources>
        <infra:GramsConverter x:Key="Grams" />
        <infra:LocalTimeConverter x:Key="Time" />
        <infra:LocalizedEnumConverter x:Key="TxStatus" Prefix="tx." />
    </UserControl.Resources>
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource s.nav.history}" Style="{StaticResource Text.H1}" />
        <local:TransactionFilterBar x:Name="Filter" DockPanel.Dock="Top" />
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="{DynamicResource s.common.search}" Style="{StaticResource Button.Primary}" Click="OnSearch" IsDefault="True" />
            <Button Content="Export Excel" Click="OnExportXlsx" />
            <Button Content="Export CSV" Click="OnExportCsv" />
            <Button Content="Export PDF" Click="OnExportPdf" />
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="{DynamicResource s.common.back}" Click="OnPrevious" x:Name="PrevButton" />
                <Button Content="{DynamicResource s.common.next}" Click="OnNext" x:Name="NextButton" />
            </StackPanel>
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" Style="{StaticResource Text.Muted}" />
        </DockPanel>
        <DataGrid x:Name="Grid" MouseDoubleClick="OnOpen" KeyDown="OnGridKey">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ticket" Binding="{Binding TicketNo}" />
                <DataGridTextColumn Header="Created" Binding="{Binding CreatedUtc, Converter={StaticResource Time}}" />
                <DataGridTextColumn Header="Vehicle" Binding="{Binding VehicleReg}" />
                <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*" />
                <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="*" />
                <DataGridTextColumn Header="Material" Binding="{Binding MaterialName}" />
                <DataGridTextColumn Header="Gross" Binding="{Binding GrossG, Converter={StaticResource Grams}}" />
                <DataGridTextColumn Header="Tare" Binding="{Binding TareG, Converter={StaticResource Grams}}" />
                <DataGridTextColumn Header="Net" Binding="{Binding NetG, Converter={StaticResource Grams}}" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status, Converter={StaticResource TxStatus}}" />
                <DataGridTextColumn Header="Mode" Binding="{Binding OperatingMode}" />
                <DataGridCheckBoxColumn Header="Manual" Binding="{Binding HasManualWeight}" />
                <DataGridCheckBoxColumn Header="Override" Binding="{Binding HasOverride}" />
                <DataGridTextColumn Header="Operator" Binding="{Binding CreatedByName}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
