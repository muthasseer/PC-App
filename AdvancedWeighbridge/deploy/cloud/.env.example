# Copy to .env (keep it private) and fill in.
AWMS_DOMAIN=awms.example.lk
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# First administrator, created on the first start only. Use a strong password and change it after signing in.
AWMS_ADMIN_USER=admin
AWMS_ADMIN_PASSWORD=
AWMS_TIMEZONE=Asia/Colombo
AWMS_REQUIRE_ADMIN_MFA=false
